[Desktop Entry]
Type=Application
Name=BalanceCraft
GenericName=Life balance planner
GenericName[it]=Bilanciamento delle aree di vita
Comment=Tasks by area of life, ordered by what needs attention
Comment[it]=Attività per aree di vita, in ordine di ciò che ha bisogno di attenzione
Exec=balancecraft %f
TryExec=balancecraft
Icon=it.mauromazzieri.balancecraft
Terminal=false
StartupNotify=true
StartupWMClass=it.mauromazzieri.balancecraft
Categories=Office;ProjectManagement;
MimeType=application/vnd.balancecraft+json;
Keywords=tasks;todo;balance;areas;planner;attività;
